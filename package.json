{
  "name": "ajaxai-monorepo",
  "version": "1.0.0",
  "description": "AjaxAI Autonomous AI Operating System UI",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:python": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev": "concurrently \"npm run dev:python\" \"npm run dev:frontend\"",
    "build": "npm run build --workspace=apps/frontend",
    "start": "npm run start --workspace=apps/frontend",
    "test": "npm run test --workspace=apps/frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
