{
  "name": "ajaxai-monorepo",
  "version": "1.0.0",
  "description": "AjaxAI Autonomous AI Operating System Monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:python": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run dev --workspace=services/backend",
    "dev:agent": "npm run dev --workspace=services/agent-runtime",
    "dev": "concurrently \"npm run dev:python\" \"npm run dev:frontend\"",
    "build": "npm run build --workspaces",
    "seed": "npm run seed --workspace=packages/shared",
    "start:frontend": "npm run start --workspace=apps/frontend",
    "start:backend": "npm run start --workspace=services/backend",
    "start:agent": "npm run start --workspace=services/agent-runtime",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
