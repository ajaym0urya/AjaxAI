# =========================================================================
# AjaxAI Config Template (.env)
# Rename this file to '.env' and place it in the project root directory
# =========================================================================

# Port configuration
PORT=3001
NODE_ENV=development

# 1. Database Layer: Azure Cosmos DB (NoSQL)
# Provide the Cosmos DB Primary Connection String to enable cloud persistence
AZURE_COSMOS_CONNECTION_STRING=""

# 2. Intelligence Layer: Azure OpenAI Service
# Provide your Azure OpenAI credentials to enable dynamic agent reasoning
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4"
AZURE_OPENAI_GPT_DEPLOYMENT="gpt-4"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"

# 3. Real-time WebSocket Gateway: Azure Web PubSub
AZURE_WEB_PUBSUB_CONNECTION_STRING=""

# 4. Frontend build-time base URLs for Azure deployment
NEXT_PUBLIC_API_BASE="http://localhost:8000/api/v1"
NEXT_PUBLIC_WS_BASE="ws://localhost:8000/api/ws"

# 5. Frontend origin used by the backend CORS configuration in Azure
FRONTEND_URL="http://localhost:3000"

# 6. Tool Engines: Document Intelligence & SMTP
AZURE_AI_DOC_INTEL_ENDPOINT=""
AZURE_AI_DOC_INTEL_KEY=""
OUTLOOK_CONNECTION_STRING=""
